{
  "name": "obsidian-mcp-filesystem",
  "version": "0.1.0",
  "description": "MCP server for Obsidian with filesystem access and content search",
  "packageManager": "pnpm@10.12.1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "start": "node src/index.js",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation-pagination": "stryker run --mutate 'src/config.js' --mutate 'src/search.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "glob": "^13.0.6",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "ajv": "^8.18.0",
    "knip": "^6.5.0",
    "lefthook": "^2.1.6",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}
